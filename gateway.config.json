{
  "server": {
    "port": 3000,
    "host": "0.0.0.0"
  },
  "restate": {
    "servicePort": 9088,
    "ingressUrl": "http://localhost:8080"
  },
  "policy": {
    "approvalTimeoutMs": 86400000,
    "rules": [
      {
        "toolPattern": "delete_.*",
        "requiresApproval": true,
        "maxRetries": 3,
        "timeoutMs": 30000
      },
      {
        "toolPattern": "execute_.*",
        "requiresApproval": true,
        "maxRetries": 3,
        "timeoutMs": 30000
      },
      {
        "toolPattern": "drop_.*",
        "requiresApproval": true,
        "maxRetries": 3,
        "timeoutMs": 30000
      },
      {
        "toolPattern": "write_.*",
        "requiresApproval": true,
        "maxRetries": 3,
        "timeoutMs": 30000
      }
    ]
  },
  "targetServers": [
    {
      "id": "sqlite",
      "name": "SQLite Database",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db-path", "./data.db"],
      "autoRestart": true
    },
    {
      "id": "filesystem",
      "name": "File System",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/home/zius/Projects/restate-mcp-gateway"],
      "autoRestart": true
    }
  ]
}